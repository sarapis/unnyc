# ---------------------------------------------------------------------------
# UNNYC — environment
#
# Both NEXT_PUBLIC_* values are OPTIONAL: src/lib/api.js defaults to exactly
# these, so local dev works with no .env at all (it reads the live CMS).
# ---------------------------------------------------------------------------

# Sarapis Payload CMS origin.
NEXT_PUBLIC_PAYLOAD_URL=https://next.sarapis.org

# Brand key in Payload's Sites collection. Scopes every CMS read/write to this
# brand. Keep as `wegovnyc` unless a dedicated UNNYC Site doc is created.
NEXT_PUBLIC_SITE_KEY=wegovnyc

# ---------------------------------------------------------------------------
# No secrets are required. ENDORSEMENT_SHEET_WEBHOOK_URL used to live here for
# the Google Sheet endorsement path; that path was removed on 2026-08-06 and
# formal organization endorsements now go to Payload's campaign-endorsements
# collection, which needs no credential beyond the public brand key above.
# ---------------------------------------------------------------------------
