{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/no-blanket-git-staging.sh\"",
            "timeout": 10,
            "statusMessage": "Checking git staging is explicit"
          }
        ]
      }
    ]
  }
}
